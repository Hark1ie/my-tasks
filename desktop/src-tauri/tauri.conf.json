{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "My Tasks",
  "version": "0.1.0",
  "identifier": "app.mytasks.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "My Tasks",
        "width": 1100,
        "height": 750,
        "minWidth": 720,
        "minHeight": 480,
        "backgroundColor": "#000000"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "publisher": "Hardik",
    "shortDescription": "My Tasks",
    "longDescription": "Personal to-do app that syncs with My Tasks on Android.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "windows": {
      "nsis": { "installMode": "currentUser" }
    }
  }
}
