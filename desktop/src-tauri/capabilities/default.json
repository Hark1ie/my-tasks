{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "What the My Tasks window may do",
  "windows": ["main"],
  "permissions": [
    "core:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [{ "url": "https://accounts.google.com/*" }]
    },
    {
      "identifier": "http:default",
      "allow": [{ "url": "https://oauth2.googleapis.com/*" }]
    },
    "oauth:allow-start",
    "oauth:allow-cancel"
  ]
}
